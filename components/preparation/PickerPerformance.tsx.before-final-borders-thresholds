"use client";

import { useMemo, useState } from "react";
import ExcelJS from "exceljs";

type Period = "DAY" | "WEEK" | "MONTH";

type Picker = {
  name: string;
  bp: number;
  parcels: number;
  lines: number;
  quantity: number;
  workedDays: number;
};

const PERIOD_LABEL: Record<Period, string> = {
  DAY: "Jour",
  WEEK: "Semaine",
  MONTH: "Mois",
};

const demoData: Record<Period, Picker[]> = {
  DAY: [
    { name: "Préparateur A", bp: 14, parcels: 32, lines: 487, quantity: 2860, workedDays: 1 },
    { name: "Préparateur B", bp: 18, parcels: 41, lines: 451, quantity: 3410, workedDays: 1 },
    { name: "Préparateur C", bp: 13, parcels: 29, lines: 424, quantity: 2550, workedDays: 1 },
    { name: "Préparateur D", bp: 17, parcels: 35, lines: 398, quantity: 3190, workedDays: 1 },
    { name: "Préparateur E", bp: 12, parcels: 27, lines: 376, quantity: 2310, workedDays: 1 },
    { name: "Préparateur F", bp: 15, parcels: 31, lines: 354, quantity: 2740, workedDays: 1 },
    { name: "Préparateur G", bp: 11, parcels: 25, lines: 337, quantity: 2110, workedDays: 1 },
    { name: "Préparateur H", bp: 10, parcels: 23, lines: 321, quantity: 1980, workedDays: 1 },
    { name: "Préparateur I", bp: 9, parcels: 21, lines: 309, quantity: 1870, workedDays: 1 },
    { name: "Préparateur J", bp: 11, parcels: 24, lines: 302, quantity: 2050, workedDays: 1 },
    { name: "Préparateur K", bp: 8, parcels: 19, lines: 284, quantity: 1710, workedDays: 1 },
    { name: "Préparateur L", bp: 7, parcels: 17, lines: 263, quantity: 1540, workedDays: 1 },
  ],

  WEEK: [
    { name: "Préparateur A", bp: 66, parcels: 100, lines: 2483, quantity: 11765, workedDays: 5 },
    { name: "Préparateur B", bp: 73, parcels: 112, lines: 2318, quantity: 10980, workedDays: 5 },
    { name: "Préparateur C", bp: 61, parcels: 98, lines: 2186, quantity: 10440, workedDays: 5 },
    { name: "Préparateur D", bp: 70, parcels: 105, lines: 2042, quantity: 9970, workedDays: 5 },
    { name: "Préparateur E", bp: 58, parcels: 91, lines: 1935, quantity: 9260, workedDays: 5 },
    { name: "Préparateur F", bp: 64, parcels: 97, lines: 1844, quantity: 8810, workedDays: 5 },
    { name: "Préparateur G", bp: 55, parcels: 86, lines: 1762, quantity: 8340, workedDays: 5 },
    { name: "Préparateur H", bp: 52, parcels: 82, lines: 1691, quantity: 7980, workedDays: 5 },
    { name: "Préparateur I", bp: 49, parcels: 79, lines: 1618, quantity: 7650, workedDays: 5 },
    { name: "Préparateur J", bp: 47, parcels: 75, lines: 1536, quantity: 7310, workedDays: 5 },
    { name: "Préparateur K", bp: 44, parcels: 70, lines: 1462, quantity: 6940, workedDays: 5 },
    { name: "Préparateur L", bp: 41, parcels: 66, lines: 1374, quantity: 6520, workedDays: 5 },
  ],

  MONTH: [
    { name: "Préparateur A", bp: 278, parcels: 428, lines: 10280, quantity: 48600, workedDays: 21 },
    { name: "Préparateur B", bp: 291, parcels: 441, lines: 9780, quantity: 46100, workedDays: 21 },
    { name: "Préparateur C", bp: 263, parcels: 409, lines: 9210, quantity: 43800, workedDays: 21 },
    { name: "Préparateur D", bp: 270, parcels: 417, lines: 8640, quantity: 41200, workedDays: 21 },
    { name: "Préparateur E", bp: 244, parcels: 382, lines: 8130, quantity: 38900, workedDays: 21 },
    { name: "Préparateur F", bp: 251, parcels: 391, lines: 7780, quantity: 37100, workedDays: 21 },
    { name: "Préparateur G", bp: 231, parcels: 365, lines: 7420, quantity: 35200, workedDays: 21 },
    { name: "Préparateur H", bp: 222, parcels: 351, lines: 7110, quantity: 33700, workedDays: 21 },
    { name: "Préparateur I", bp: 215, parcels: 342, lines: 6810, quantity: 32200, workedDays: 21 },
    { name: "Préparateur J", bp: 207, parcels: 331, lines: 6480, quantity: 30700, workedDays: 21 },
    { name: "Préparateur K", bp: 194, parcels: 314, lines: 6030, quantity: 28600, workedDays: 21 },
    { name: "Préparateur L", bp: 181, parcels: 298, lines: 5680, quantity: 26900, workedDays: 21 },
  ],
};

export default function PickerPerformance() {
  const [period, setPeriod] = useState<Period>("WEEK");

  const ranked = useMemo(
    () => [...demoData[period]].sort((a, b) => b.lines - a.lines),
    [period]
  );

  const exportExcel = async () => {
    const workbook = new ExcelJS.Workbook();

    workbook.creator = "Organ·IA Flow";
    workbook.created = new Date();

    const worksheet = workbook.addWorksheet("Classement", {
      views: [
        {
          state: "frozen",
          ySplit: 2,
          showGridLines: true,
        },
      ],
    });

    const formatDate = (date: Date) =>
      date.toLocaleDateString("fr-FR", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
      });

    const today = new Date();

    let periodTitle = "";
    let objectiveLabel = 300;

    if (period === "DAY") {
      periodTitle = `JOURNÉE DU ${formatDate(today)}`;
      objectiveLabel = 300;
    }

    if (period === "WEEK") {
      const monday = new Date(today);
      const day = monday.getDay();
      const diff = day === 0 ? -6 : 1 - day;

      monday.setDate(monday.getDate() + diff);

      const sunday = new Date(monday);
      sunday.setDate(monday.getDate() + 6);

      periodTitle =
        `SEMAINE DU ${formatDate(monday)} AU ${formatDate(sunday)}`;

      objectiveLabel = 1500;
    }

    if (period === "MONTH") {
      const firstDay = new Date(
        today.getFullYear(),
        today.getMonth(),
        1
      );

      const lastDay = new Date(
        today.getFullYear(),
        today.getMonth() + 1,
        0
      );

      periodTitle =
        `MOIS DU ${formatDate(firstDay)} AU ${formatDate(lastDay)}`;

      objectiveLabel = Math.max(
        ...ranked.map((picker) => picker.workedDays * 300)
      );
    }

    const totalBp = ranked.reduce(
      (sum, picker) => sum + picker.bp,
      0
    );

    const totalParcels = ranked.reduce(
      (sum, picker) => sum + picker.parcels,
      0
    );

    const totalLines = ranked.reduce(
      (sum, picker) => sum + picker.lines,
      0
    );

    const totalQuantity = ranked.reduce(
      (sum, picker) => sum + picker.quantity,
      0
    );

    // =========================
    // TITRE DE PERIODE
    // =========================

    worksheet.mergeCells("A1:E1");

    const periodCell = worksheet.getCell("A1");

    periodCell.value = periodTitle;

    periodCell.font = {
      bold: true,
      size: 11,
      color: { argb: "FF111111" },
    };

    periodCell.alignment = {
      horizontal: "center",
      vertical: "middle",
    };

    worksheet.getRow(1).height = 23;

    // =========================
    // ENTETES TYPE TABLEAU OPENSi
    // =========================

    const headerRow = worksheet.addRow([
      "Préparateur",
      "Nombre de BP",
      "Somme de Nb colis",
      "Somme de Nb lignes",
      "Somme de Qté totale",
    ]);

    headerRow.height = 23;

    headerRow.eachCell((cell) => {
      cell.font = {
        bold: true,
        size: 10,
        color: { argb: "FF111111" },
      };

      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "FFD9EAF7" },
      };

      cell.alignment = {
        horizontal: "center",
        vertical: "middle",
        wrapText: true,
      };

      cell.border = {
        top: {
          style: "thin",
          color: { argb: "FF808080" },
        },
        bottom: {
          style: "thin",
          color: { argb: "FF808080" },
        },
        left: {
          style: "thin",
          color: { argb: "FF808080" },
        },
        right: {
          style: "thin",
          color: { argb: "FF808080" },
        },
      };
    });

    let lastObjectiveRow = -1;

    // =========================
    // CLASSEMENT
    // =========================

    ranked.forEach((picker, index) => {
      const objective = picker.workedDays * 300;
      const objectiveReached = picker.lines >= objective;

      const row = worksheet.addRow([
        picker.name,
        picker.bp,
        picker.parcels,
        picker.lines,
        picker.quantity,
      ]);

      row.height = 20;

      if (objectiveReached) {
        lastObjectiveRow = row.number;
      }

      // TOP 3 = JAUNE
      if (index < 3) {
        row.eachCell((cell) => {
          cell.fill = {
            type: "pattern",
            pattern: "solid",
            fgColor: { argb: "FFFFFF00" },
          };

          cell.font = {
            bold: false,
            color: { argb: "FF000000" },
          };
        });
      }

      // 4 A 10 = ORANGE
      else if (index < 10) {
        row.eachCell((cell) => {
          cell.fill = {
            type: "pattern",
            pattern: "solid",
            fgColor: { argb: "FFFFC000" },
          };

          cell.font = {
            color: { argb: "FF000000" },
          };
        });
      }

      row.eachCell((cell, columnNumber) => {
        cell.alignment = {
          horizontal: columnNumber === 1 ? "left" : "center",
          vertical: "middle",
        };

        cell.border = {
          left: {
            style: "thin",
            color: { argb: "FFB7B7B7" },
          },
          right: {
            style: "thin",
            color: { argb: "FFB7B7B7" },
          },
        };
      });
    });

    // =========================
    // TRAIT OBJECTIF
    // =========================

    if (lastObjectiveRow > 0) {
      const objectiveRow = worksheet.getRow(lastObjectiveRow);

      for (let column = 1; column <= 5; column++) {
        const cell = objectiveRow.getCell(column);

        cell.border = {
          ...cell.border,

          bottom: {
            style: "medium",
            color: { argb: "FF000000" },
          },
        };
      }
    }

    // =========================
    // TOTAL GENERAL
    // =========================

    const totalRow = worksheet.addRow([
      "TOTAL GÉNÉRAL",
      totalBp,
      totalParcels,
      totalLines,
      totalQuantity,
    ]);

    totalRow.height = 21;

    totalRow.eachCell((cell, columnNumber) => {
      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "FFBFE3F1" },
      };

      cell.font = {
        bold: true,
        color: { argb: "FF111111" },
      };

      cell.alignment = {
        horizontal: columnNumber === 1 ? "left" : "center",
        vertical: "middle",
      };

      cell.border = {
        top: {
          style: "medium",
          color: { argb: "FF000000" },
        },
        bottom: {
          style: "medium",
          color: { argb: "FF000000" },
        },
        left: {
          style: "thin",
          color: { argb: "FF000000" },
        },
        right: {
          style: "thin",
          color: { argb: "FF000000" },
        },
      };
    });

    // =========================
    // FORMAT NOMBRES
    // =========================

    for (
      let rowNumber = 3;
      rowNumber <= totalRow.number;
      rowNumber++
    ) {
      worksheet.getCell(`B${rowNumber}`).numFmt = "#,##0";
      worksheet.getCell(`C${rowNumber}`).numFmt = "#,##0";
      worksheet.getCell(`D${rowNumber}`).numFmt = "#,##0";
      worksheet.getCell(`E${rowNumber}`).numFmt = "#,##0";
    }

    // =========================
    // LARGEURS COMPACTES
    // =========================

    worksheet.getColumn("A").width = 23;
    worksheet.getColumn("B").width = 15;
    worksheet.getColumn("C").width = 17;
    worksheet.getColumn("D").width = 19;
    worksheet.getColumn("E").width = 20;

    // Filtre comme un tableau Excel
    worksheet.autoFilter = {
      from: "A2",
      to: "E2",
    };

    // =========================
    // IMPRESSION A4 PORTRAIT
    // =========================

    worksheet.pageSetup.orientation = "portrait";
    worksheet.pageSetup.paperSize = 9;

    worksheet.pageSetup.fitToPage = true;
    worksheet.pageSetup.fitToWidth = 1;
    worksheet.pageSetup.fitToHeight = 1;

    worksheet.pageSetup.horizontalCentered = true;
    worksheet.pageSetup.verticalCentered = false;

    worksheet.pageSetup.margins = {
      left: 0.25,
      right: 0.25,
      top: 0.30,
      bottom: 0.30,
      header: 0.10,
      footer: 0.10,
    };

    worksheet.pageSetup.printArea =
      `A1:E${totalRow.number}`;

    worksheet.pageSetup.printTitlesRow = "1:2";

    // Petit rappel objectif uniquement en pied de page,
    // pas dans le tableau imprimé.
    worksheet.headerFooter.oddFooter =
      `&LObjectif ${objectiveLabel} lignes&COrgan·IA Flow&RPage &P / &N`;

    // =========================
    // EXPORT
    // =========================

    const buffer = await workbook.xlsx.writeBuffer();

    const blob = new Blob([buffer], {
      type:
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    });

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    const safePeriod = periodTitle
      .toLowerCase()
      .replaceAll("/", "-")
      .replaceAll(" ", "_");

    anchor.href = url;
    anchor.download =
      `classement-preparateurs-${safePeriod}.xlsx`;

    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();

    URL.revokeObjectURL(url);
  };

  return (
    <section className="organia-electric-panel organia-electric-panel-v2 rounded-3xl border border-[#008cff]/45 bg-gradient-to-br from-[#071426] via-[#04111f] to-[#020617] p-6 shadow-sm">
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p className="text-xs font-bold uppercase tracking-[0.22em] text-[#00e5ff]">
            Préparation Intelligence
          </p>

          <h2 className="mt-1 text-xl font-bold text-white">
            Performance préparateurs
          </h2>

          <p className="mt-1 text-sm text-slate-400">
            Classement par lignes préparées · objectif 300 lignes / jour travaillé
          </p>
        </div>

        <button
          type="button"
          onClick={exportExcel}
          className="rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-2 text-xs font-black text-emerald-300 transition hover:bg-emerald-500/20"
        >
          Exporter Excel
        </button>
      </div>

      <div className="mt-5 flex gap-2">
        {(["DAY", "WEEK", "MONTH"] as Period[]).map((value) => (
          <button
            key={value}
            type="button"
            onClick={() => setPeriod(value)}
            className={`rounded-xl px-4 py-2 text-xs font-black transition ${
              period === value
                ? "bg-cyan-400 text-[#02111d]"
                : "border border-slate-700 bg-slate-900 text-slate-300 hover:border-cyan-400/50"
            }`}
          >
            {PERIOD_LABEL[value]}
          </button>
        ))}
      </div>

      <div className="mt-5 overflow-x-auto">
        <table className="w-full min-w-[850px] text-sm">
          <thead>
            <tr className="border-b border-cyan-400/20 text-left text-xs uppercase tracking-wider text-slate-500">
              <th className="px-3 py-3">Rang</th>
              <th className="px-3 py-3">Préparateur</th>
              <th className="px-3 py-3 text-right">BP</th>
              <th className="px-3 py-3 text-right">Colis</th>
              <th className="px-3 py-3 text-right">Lignes</th>
              <th className="px-3 py-3 text-right">Qté</th>
              <th className="px-3 py-3 text-right">Objectif</th>
              <th className="px-3 py-3 text-right">Écart</th>
            </tr>
          </thead>

          <tbody>
            {ranked.map((picker, index) => {
              const objective = picker.workedDays * 300;
              const difference = picker.lines - objective;
              const top3 = index < 3;
              const top10 = index >= 3 && index < 10;

              return (
                <tr
                  key={picker.name}
                  className={`border-b ${
                    top3
                      ? "border-yellow-400/25 bg-yellow-400/10"
                      : top10
                        ? "border-orange-400/20 bg-orange-400/[0.06]"
                        : "border-slate-800"
                  }`}
                >
                  <td className="px-3 py-3 font-black text-white">
                    {index + 1}
                  </td>

                  <td className="px-3 py-3 font-bold text-white">
                    {picker.name}
                  </td>

                  <td className="px-3 py-3 text-right text-slate-300">
                    {picker.bp}
                  </td>

                  <td className="px-3 py-3 text-right text-slate-300">
                    {picker.parcels}
                  </td>

                  <td className="px-3 py-3 text-right text-lg font-black text-cyan-300">
                    {picker.lines.toLocaleString("fr-FR")}
                  </td>

                  <td className="px-3 py-3 text-right text-slate-300">
                    {picker.quantity.toLocaleString("fr-FR")}
                  </td>

                  <td className="px-3 py-3 text-right text-slate-400">
                    {objective.toLocaleString("fr-FR")}
                  </td>

                  <td
                    className={`px-3 py-3 text-right font-black ${
                      difference >= 0
                        ? "text-emerald-300"
                        : "text-red-400"
                    }`}
                  >
                    {difference >= 0 ? "+" : ""}
                    {difference.toLocaleString("fr-FR")}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div className="mt-4 flex flex-wrap gap-4 text-xs font-semibold">
        <span className="text-yellow-300">● Top 3</span>
        <span className="text-orange-300">● Top 10</span>
        <span className="text-emerald-300">● Objectif atteint</span>
        <span className="text-red-400">● Sous objectif</span>
      </div>

      <div className="mt-5 rounded-2xl border border-[#00e5ff]/30 bg-gradient-to-r from-[#006bff]/12 to-[#00e5ff]/6 p-4">
        <p className="text-sm font-black text-[#00e5ff]">
          Analyse Libot
        </p>

        <p className="mt-1 text-sm text-slate-300">
          Le classement est établi sur le nombre de lignes préparées.
          L'objectif individuel est calculé sur 300 lignes par jour réellement travaillé.
        </p>
      </div>
    </section>
  );
}
