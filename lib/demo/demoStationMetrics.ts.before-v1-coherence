const PREPARATION_START_MINUTES = 9 * 60 + 20;

const STEP_TIMES: Record<number, string> = {
  1: "08:00",
  2: "08:10",
  3: "08:24",
  4: "08:31",
  5: "09:05",
  6: "09:20",
  7: "12:15",
  8: "12:17",
  9: "13:05",
  10: "14:35",
  11: "15:40",
  12: "16:05",
  13: "17:30",
};

function timeToMinutes(time: string) {
  const [hours, minutes] = time.split(":").map(Number);
  return hours * 60 + minutes;
}

function clamp(value: number, min: number, max: number) {
  return Math.max(min, Math.min(max, value));
}

function calculatePreparationProductivity(
  stepId: number,
  snapshot: DemoStationSnapshot
) {
  const stepTime = STEP_TIMES[stepId];

  if (
    !stepTime ||
    snapshot.preparedLines <= 0 ||
    snapshot.pickersActive <= 0
  ) {
    return 0;
  }

  const elapsedMinutes =
    timeToMinutes(stepTime) - PREPARATION_START_MINUTES;

  if (elapsedMinutes <= 0) {
    return 0;
  }

  const elapsedHours = elapsedMinutes / 60;

  const linesPerPickerHour =
    snapshot.preparedLines /
    snapshot.pickersActive /
    elapsedHours;

  return Math.round(linesPerPickerHour);
}

function calculateWarehouseHealth(snapshot: DemoStationSnapshot) {
  const printedOrders = snapshot.ordersPrinted;
  const completedOrders = snapshot.ordersCompleted;

  // Aucune commande imprimee = aucune charge de preparation en attente.
  if (printedOrders <= 0) {
    return 100;
  }

  const health =
    (completedOrders / printedOrders) * 100;

  return Math.max(
    0,
    Math.min(100, Math.round(health)),
  );
}

export const demoStationSnapshots: Record<
  number,
  DemoStationSnapshot
> = Object.fromEntries(
  Object.entries(rawDemoStationSnapshots).map(([stepId, snapshot]) => {
    const numericStepId = Number(stepId);

    return [
      numericStepId,
      {
        ...snapshot,
        productivity: calculatePreparationProductivity(
          numericStepId,
          snapshot
        ),
        warehouseHealth: calculateWarehouseHealth(snapshot),
      },
    ];
  })
);
