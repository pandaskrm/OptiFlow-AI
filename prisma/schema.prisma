generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * AUTHENTIFICATION ET ENTREPRISES
 */

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsCreated  Invitation[]         @relation("InvitationCreator")
  auditLogs           AuditLog[]           @relation("AuditActor")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  legalName  String?
  siret      String?
  email      String?
  phone      String?
  address    String?
  postalCode String?
  city       String?
  country    String   @default("France")
  logoUrl    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  warehouses      Warehouse[]
  auditLogs       AuditLog[]
  erpConnections  ErpConnection[]
  mailConnections MailConnection[]
  mailMessages    MailMessage[]

  receptions          Reception[]
  receptionDocuments  ReceptionDocument[]
  receptionEvents     ReceptionEvent[]
  receptionInspectors ReceptionInspector[]
  orders              Order[]
  shipments           Shipment[]
  inventories         Inventory[]
  workforce           Workforce[]
  carriers            Carrier[]
  businessRules       BusinessRule[]
}

/**
 * REGLES METIER CONFIGURABLES
 * Chaque entreprise peut définir ses propres priorités,
 * procédures, badges, checklists et actions.
 */

model BusinessRule {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  scope       String
  targetValue String
  priority    String   @default("NORMALE")
  badge       String?
  color       String?
  workflow    String?
  explanation String?
  checklist   Json?
  actions     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, targetValue, name])
  @@index([companyId, scope])
  @@index([companyId, isActive])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("OPERATOR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages MailMessage[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        String    @default("OPERATOR")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@index([expiresAt])
}

/**
 * REFERENTIEL DES TRANSPORTEURS
 */

model Carrier {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  code                  String?
  contactName           String?
  email                 String?
  secondaryEmail        String?
  phone                 String?
  averageLeadTimeHours  Int?
  notes                 String?
  supportsPallet        Boolean  @default(true)
  supportsParcel        Boolean  @default(false)
  supportsExpress       Boolean  @default(false)
  supportsNational      Boolean  @default(true)
  supportsInternational Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, isActive])
}

model Warehouse {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  code       String
  address    String?
  postalCode String?
  city       String?
  country    String   @default("France")
  timezone   String   @default("Europe/Paris")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docks   Dock[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Dock {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  code        String
  type        String   @default("MIXED")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorId])
  @@index([createdAt])
}

/**
 * DONNÃ‰ES LOGISTIQUES
 * companyId reste facultatif pendant la transition afin de ne pas casser
 * les API actuelles. Il deviendra obligatoire quand lâ€™isolation multi-client
 * sera branchÃ©e dans les services.
 */

model Reception {
  id                  Int       @id @default(autoincrement())
  number              String    @unique
  supplier            String
  carrier             String
  dock                String
  pallets             Int
  status              String
  scheduledAt         String
  arrivedAt           DateTime?
  unloadingStartedAt  DateTime?
  inspectionStartedAt DateTime?
  qualityResult       String?
  qualityValidatedBy  String?
  qualityValidatedAt  DateTime?
  qualityComment      String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  mailMessages        MailMessage[]
  receptionDocuments  ReceptionDocument[]
  receptionEvents     ReceptionEvent[]
  receptionInspectors ReceptionInspector[]

  @@index([companyId])
}

model ReceptionDocument {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  type        String   @default("DELIVERY_NOTE")
  name        String
  contentType String
  size        Int
  content     Bytes
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([receptionId])
  @@index([companyId, receptionId])
  @@index([capturedAt])
}

model ReceptionInspector {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  userId      String?
  firstName   String
  lastName    String
  assignedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@unique([receptionId, userId])
  @@index([companyId])
  @@index([receptionId])
  @@index([userId])
}

model ReceptionEvent {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  type        String
  fromStatus  String?
  toStatus    String?
  happenedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([receptionId])
  @@index([companyId, receptionId])
  @@index([happenedAt])
}

model Order {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  customer      String
  carrier       String?
  priority      String    @default("Normale")
  status        String    @default("À préparer")
  totalLines    Int       @default(0)
  preparedLines Int       @default(0)

  // Date reelle a laquelle le client a passe la commande dans OpenSi.
  // Cette date pilote l'ordre des files de preparation PDA.
  orderDate     DateTime?
  customerCode  String?
  country       String?
  paymentMethod String?
  totalQuantity Int?
  // Reservation atomique d'une commande envoyee sur un PDA.
  pdaReservedBy       String?
  pdaReservedAt       DateTime?
  pdaReservationToken String?   @unique
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Shipment {
  id          Int       @id @default(autoincrement())
  number      String    @unique
  orderNumber String?
  customer    String
  carrier     String
  dock        String?
  status      String    @default("À expédier")
  pallets     Int       @default(0)
  packages    Int       @default(0)
  scheduledAt DateTime?
  shippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Inventory {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  designation String
  location    String?
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  minimum     Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Workforce {
  id             Int      @id @default(autoincrement())
  employeeNumber String   @unique
  name           String
  team           String?
  zone           String?
  status         String   @default("Présent")
  workedMinutes  Int      @default(0)
  processedUnits Int      @default(0)
  workDate       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

/**
 * CONNEXIONS ERP
 * Une configuration ERP appartient obligatoirement à une entreprise.
 * Les informations sensibles devront être chiffrées côté serveur.
 */

/**
 * CONNEXIONS DE MESSAGERIE
 */

/**
 * E-MAILS LOGISTIQUES ENTRANTS
 */

model MailMessage {
  id                String    @id @default(cuid())
  companyId         String
  connectionId      String?
  receptionId       Int?
  externalId        String
  internetMessageId String?
  outlookFolderId   String?
  outlookFolderName String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  subject           String
  senderEmail       String
  senderName        String?
  receivedAt        DateTime
  bodyText          String?
  bodyHtml          String?
  status            String    @default("NEW")
  classification    String?
  confidence        Float?
  extractedData     Json?
  processingError   String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection   MailConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  reception    Reception?       @relation(fields: [receptionId], references: [id], onDelete: SetNull)
  membership   Membership?      @relation(fields: [membershipId], references: [id])
  attachments  MailAttachment[]
  membershipId String?

  @@unique([companyId, externalId])
  @@index([companyId, status])
  @@index([connectionId])
  @@index([receptionId])
  @@index([receivedAt])
  @@index([companyId, isRead])
  @@index([companyId, outlookFolderId])
}

/**
 * PIÈCES JOINTES DES E-MAILS LOGISTIQUES
 */

model MailAttachment {
  id          String   @id @default(cuid())
  messageId   String
  externalId  String
  name        String
  contentType String?
  size        Int      @default(0)
  isInline    Boolean  @default(false)
  content     Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, externalId])
  @@index([messageId])
  @@index([name])
}

model MailConnection {
  id                    String  @id @default(cuid())
  companyId             String
  provider              String
  emailAddress          String
  host                  String?
  port                  Int     @default(993)
  username              String?
  passwordEncrypted     String?
  tenantId              String?
  clientId              String?
  clientSecretEncrypted String?

  authType              String    @default("LEGACY")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  oauthScopes           String?

  isEnabled    Boolean   @default(false)
  status       String    @default("DISCONNECTED")
  lastTestedAt DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mailMessages MailMessage[]

  @@unique([companyId, emailAddress])
  @@index([companyId])
}

model ErpConnection {
  id                String    @id @default(cuid())
  companyId         String
  provider          String
  name              String
  apiUrl            String?
  apiKeyEncrypted   String?
  externalCompanyId String?
  isEnabled         Boolean   @default(false)
  status            String    @default("DISCONNECTED")
  lastTestedAt      DateTime?
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([provider])
  @@index([status])
}
