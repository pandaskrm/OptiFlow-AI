generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * AUTHENTIFICATION ET ENTREPRISES
 */

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsCreated  Invitation[]         @relation("InvitationCreator")
  auditLogs           AuditLog[]           @relation("AuditActor")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  legalName  String?
  siret      String?
  email      String?
  phone      String?
  address    String?
  postalCode String?
  city       String?
  country    String   @default("France")
  logoUrl    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  warehouses      Warehouse[]
  auditLogs       AuditLog[]
  erpConnections  ErpConnection[]
  mailConnections MailConnection[]
  mailMessages    MailMessage[]

  receptions           Reception[]
  receptionDocuments   ReceptionDocument[]
  receptionEvents      ReceptionEvent[]
  receptionInspectors  ReceptionInspector[]
  orders               Order[]
  shipments            Shipment[]
  inventories          Inventory[]
  workforce            Workforce[]
  carriers             Carrier[]
  businessRules        BusinessRule[]
  workforceJobs        WorkforceJob[]
  workforceAccessCodes WorkforceAccessCode[]
  presenceQrSessions   PresenceQrSession[]
  absenceRequests      AbsenceRequest[]
}

/**
 * REGLES METIER CONFIGURABLES
 * Chaque entreprise peut définir ses propres priorités,
 * procédures, badges, checklists et actions.
 */

model BusinessRule {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  scope       String
  targetValue String
  priority    String   @default("NORMALE")
  badge       String?
  color       String?
  workflow    String?
  explanation String?
  checklist   Json?
  actions     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, targetValue, name])
  @@index([companyId, scope])
  @@index([companyId, isActive])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("OPERATOR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  MailMessage[]
  workforce Workforce?

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  role        String    @default("OPERATOR")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@index([expiresAt])
}

/**
 * REFERENTIEL DES TRANSPORTEURS
 */

model Carrier {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  code                  String?
  contactName           String?
  email                 String?
  secondaryEmail        String?
  phone                 String?
  averageLeadTimeHours  Int?
  notes                 String?
  supportsPallet        Boolean  @default(true)
  supportsParcel        Boolean  @default(false)
  supportsExpress       Boolean  @default(false)
  supportsNational      Boolean  @default(true)
  supportsInternational Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, isActive])
}

model Warehouse {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  code       String
  address    String?
  postalCode String?
  city       String?
  country    String   @default("France")
  timezone   String   @default("Europe/Paris")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docks   Dock[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Dock {
  id          String   @id @default(cuid())
  warehouseId String
  name        String
  code        String
  type        String   @default("MIXED")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorId])
  @@index([createdAt])
}

/**
 * DONNÃ‰ES LOGISTIQUES
 * companyId reste facultatif pendant la transition afin de ne pas casser
 * les API actuelles. Il deviendra obligatoire quand lâ€™isolation multi-client
 * sera branchÃ©e dans les services.
 */

model Reception {
  id                  Int       @id @default(autoincrement())
  number              String    @unique
  supplier            String
  carrier             String
  dock                String
  pallets             Int
  status              String
  scheduledAt         String
  arrivedAt           DateTime?
  unloadingStartedAt  DateTime?
  inspectionStartedAt DateTime?
  qualityResult       String?
  qualityValidatedBy  String?
  qualityValidatedAt  DateTime?
  qualityComment      String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  mailMessages        MailMessage[]
  receptionDocuments  ReceptionDocument[]
  receptionEvents     ReceptionEvent[]
  receptionInspectors ReceptionInspector[]

  @@index([companyId])
}

model ReceptionDocument {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  type        String   @default("DELIVERY_NOTE")
  name        String
  contentType String
  size        Int
  content     Bytes
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([receptionId])
  @@index([companyId, receptionId])
  @@index([capturedAt])
}

model ReceptionInspector {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  userId      String?
  firstName   String
  lastName    String
  assignedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@unique([receptionId, userId])
  @@index([companyId])
  @@index([receptionId])
  @@index([userId])
}

model ReceptionEvent {
  id          String   @id @default(cuid())
  companyId   String
  receptionId Int
  type        String
  fromStatus  String?
  toStatus    String?
  happenedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([receptionId])
  @@index([companyId, receptionId])
  @@index([happenedAt])
}

model Order {
  id            Int     @id @default(autoincrement())
  number        String  @unique
  customer      String
  carrier       String?
  priority      String  @default("Normale")
  status        String  @default("À préparer")
  totalLines    Int     @default(0)
  preparedLines Int     @default(0)

  // Date reelle a laquelle le client a passe la commande dans OpenSi.
  // Cette date pilote l'ordre des files de preparation PDA.
  orderDate           DateTime?
  customerCode        String?
  country             String?
  paymentMethod       String?
  totalQuantity       Int?
  // Reservation atomique d'une commande envoyee sur un PDA.
  pdaReservedBy       String?
  pdaReservedAt       DateTime?
  pdaReservationToken String?   @unique
  scheduledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lines     OrderLine[]

  @@index([companyId])
}

model OrderLine {
  id Int @id @default(autoincrement())

  // Identifiant article provenant de l'ERP.
  sku String

  // Designation affichee au preparateur.
  label String

  // Emplacement de picking transmis par l'ERP/WMS.
  location String?

  // Code-barres utilise pour le controle PDA.
  barcode String?

  // Quantite demandee sur la commande client.
  requestedQuantity Int

  // Quantite effectivement preparee.
  preparedQuantity Int @default(0)

  // Quantite declaree manquante pendant la preparation.
  missingQuantity Int @default(0)

  // Position de la ligne dans la commande source.
  lineNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sku])
  @@index([barcode])
  @@index([location])
}

model Shipment {
  id          Int       @id @default(autoincrement())
  number      String    @unique
  orderNumber String?
  customer    String
  carrier     String
  dock        String?
  status      String    @default("À expédier")
  pallets     Int       @default(0)
  packages    Int       @default(0)
  scheduledAt DateTime?
  shippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Inventory {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  designation String
  location    String?
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  minimum     Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Workforce {
  id               Int      @id @default(autoincrement())
  employeeNumber   String   @unique
  name             String
  team             String?
  service          String?
  jobTitle         String?
  contractType     String?
  agency           String?
  jobId            String?
  membershipId     String?  @unique
  onboardingStatus String   @default("ACTIVE")
  onboardingSource String   @default("MANUAL")
  isActive         Boolean  @default(true)
  zone             String?
  status           String   @default("Présent")
  workedMinutes    Int      @default(0)
  processedUnits   Int      @default(0)
  workDate         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyId  String?
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  job        WorkforceJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  membership Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  presenceSchedules PresenceSchedule[]
  presencePunches   PresencePunch[]
  presenceDays      PresenceDay[]
  absenceRequests   AbsenceRequest[]
  performanceDays   WorkforcePerformanceDay[]

  @@index([companyId])
  @@index([jobId])
  @@index([companyId, service])
  @@index([companyId, contractType])
}

model WorkforceJob {
  id        String   @id @default(cuid())
  companyId String
  code      String?
  name      String
  service   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workers Workforce[]

  @@unique([companyId, name, service])
  @@index([companyId, isActive])
  @@index([companyId, service])
}

model WorkforceAccessCode {
  id               String    @id @default(cuid())
  companyId        String
  label            String
  codeHash         String    @unique
  codeHint         String?
  agency           String?
  contractType     String?
  isActive         Boolean   @default(true)
  requiresApproval Boolean   @default(false)
  maxUses          Int?
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@index([companyId, agency])
  @@index([expiresAt])
}

model PresenceQrSession {
  id         String    @id @default(cuid())
  companyId  String
  workDate   DateTime
  type       String
  tokenHash  String    @unique
  tokenHint  String?
  validFrom  DateTime
  validUntil DateTime
  isActive   Boolean   @default(true)
  createdBy  String?
  printedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, workDate, type])
  @@index([companyId, isActive])
  @@index([validUntil])
}

model PresenceSchedule {
  id             String    @id @default(cuid())
  workforceId    Int
  dayOfWeek      Int
  morningStart   String?
  morningEnd     String?
  afternoonStart String?
  afternoonEnd   String?
  isWorkingDay   Boolean   @default(true)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workforce Workforce @relation(fields: [workforceId], references: [id], onDelete: Cascade)

  @@index([workforceId])
  @@index([workforceId, dayOfWeek])
}

model PresencePunch {
  id          String   @id @default(cuid())
  workforceId Int
  type        String
  punchedAt   DateTime
  source      String   @default("MANUAL")
  deviceId    String?
  note        String?
  createdAt   DateTime @default(now())

  workforce Workforce @relation(fields: [workforceId], references: [id], onDelete: Cascade)

  @@index([workforceId, punchedAt])
  @@index([punchedAt])
}

model PresenceDay {
  id                 String    @id @default(cuid())
  workforceId        Int
  workDate           DateTime
  dayCode            String?
  plannedMinutes     Int       @default(0)
  calculatedMinutes  Int       @default(0)
  approvedMinutes    Int?
  status             String    @default("DRAFT")
  anomaly            Boolean   @default(false)
  anomalyReason      String?
  note               String?
  managerValidatedAt DateTime?
  managerValidatedBy String?
  hrValidatedAt      DateTime?
  hrValidatedBy      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workforce   Workforce            @relation(fields: [workforceId], references: [id], onDelete: Cascade)
  corrections PresenceCorrection[]

  @@unique([workforceId, workDate])
  @@index([workDate])
  @@index([status])
  @@index([dayCode])
}

model AbsenceRequest {
  id              String    @id @default(cuid())
  workforceId     Int
  companyId       String
  type            String
  startDate       DateTime
  endDate         DateTime
  startPart       String    @default("FULL_DAY")
  endPart         String    @default("FULL_DAY")
  employeeComment String?
  status          String    @default("PENDING")
  submittedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  decisionComment String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workforce Workforce                @relation(fields: [workforceId], references: [id], onDelete: Cascade)
  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents AbsenceRequestDocument[]
  approvals AbsenceApproval[]

  @@index([workforceId, startDate])
  @@index([companyId, status])
  @@index([status])
  @@index([startDate, endDate])
}

model AbsenceRequestDocument {
  id               String   @id @default(cuid())
  absenceRequestId String
  fileName         String
  contentType      String?
  size             Int      @default(0)
  storageKey       String
  category         String   @default("JUSTIFICATIF")
  isMedical        Boolean  @default(false)
  uploadedAt       DateTime @default(now())

  absenceRequest AbsenceRequest @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)

  @@index([absenceRequestId])
  @@index([isMedical])
}

model AbsenceApproval {
  id               String    @id @default(cuid())
  absenceRequestId String
  step             Int       @default(1)
  approverRole     String?
  approverUserId   String?
  decision         String    @default("PENDING")
  decisionComment  String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  absenceRequest AbsenceRequest @relation(fields: [absenceRequestId], references: [id], onDelete: Cascade)

  @@index([absenceRequestId, step])
  @@index([approverUserId])
  @@index([decision])
}

model PresenceCorrection {
  id               String   @id @default(cuid())
  presenceDayId    String
  originalMinutes  Int?
  correctedMinutes Int
  originalDayCode  String?
  correctedDayCode String?
  reason           String
  correctedBy      String?
  createdAt        DateTime @default(now())

  presenceDay PresenceDay @relation(fields: [presenceDayId], references: [id], onDelete: Cascade)

  @@index([presenceDayId])
  @@index([createdAt])
}

/**
 * CONNEXIONS ERP
 * Une configuration ERP appartient obligatoirement à une entreprise.
 * Les informations sensibles devront être chiffrées côté serveur.
 */

/**
 * CONNEXIONS DE MESSAGERIE
 */

/**
 * E-MAILS LOGISTIQUES ENTRANTS
 */

model MailMessage {
  id                String    @id @default(cuid())
  companyId         String
  connectionId      String?
  receptionId       Int?
  externalId        String
  internetMessageId String?
  outlookFolderId   String?
  outlookFolderName String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  subject           String
  senderEmail       String
  senderName        String?
  receivedAt        DateTime
  bodyText          String?
  bodyHtml          String?
  status            String    @default("NEW")
  classification    String?
  confidence        Float?
  extractedData     Json?
  processingError   String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection   MailConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  reception    Reception?       @relation(fields: [receptionId], references: [id], onDelete: SetNull)
  membership   Membership?      @relation(fields: [membershipId], references: [id])
  attachments  MailAttachment[]
  membershipId String?

  @@unique([companyId, externalId])
  @@index([companyId, status])
  @@index([connectionId])
  @@index([receptionId])
  @@index([receivedAt])
  @@index([companyId, isRead])
  @@index([companyId, outlookFolderId])
}

/**
 * PIÈCES JOINTES DES E-MAILS LOGISTIQUES
 */

model MailAttachment {
  id          String   @id @default(cuid())
  messageId   String
  externalId  String
  name        String
  contentType String?
  size        Int      @default(0)
  isInline    Boolean  @default(false)
  content     Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, externalId])
  @@index([messageId])
  @@index([name])
}

model MailConnection {
  id                    String  @id @default(cuid())
  companyId             String
  provider              String
  emailAddress          String
  host                  String?
  port                  Int     @default(993)
  username              String?
  passwordEncrypted     String?
  tenantId              String?
  clientId              String?
  clientSecretEncrypted String?

  authType              String    @default("LEGACY")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  oauthScopes           String?

  isEnabled    Boolean   @default(false)
  status       String    @default("DISCONNECTED")
  lastTestedAt DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mailMessages MailMessage[]

  @@unique([companyId, emailAddress])
  @@index([companyId])
}

model ErpConnection {
  id                String    @id @default(cuid())
  companyId         String
  provider          String
  name              String
  apiUrl            String?
  apiKeyEncrypted   String?
  externalCompanyId String?
  isEnabled         Boolean   @default(false)
  status            String    @default("DISCONNECTED")
  lastTestedAt      DateTime?
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([provider])
  @@index([status])
}

model WorkforcePerformanceDay {
  id               String   @id @default(cuid())
  workforceId      Int
  workDate         DateTime
  preparedOrders   Int      @default(0)
  preparedLines    Int      @default(0)
  preparedParcels  Int      @default(0)
  preparedQuantity Int      @default(0)
  workedMinutes    Int      @default(0)
  source           String   @default("ORGANIA")
  sourceReference  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workforce Workforce @relation(fields: [workforceId], references: [id], onDelete: Cascade)

  @@unique([workforceId, workDate])
  @@index([workDate])
  @@index([workforceId, workDate])
}
